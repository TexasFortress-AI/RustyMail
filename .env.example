# For Mock testing (default)
IMAP_ADAPTER=mock  # No real credentials needed

# Real credentials for specific provider
# IMAP_ADAPTER=godaddy  # or gmail, outlook, etc.
# IMAP_HOST=imap.secureserver.net
# IMAP_PORT=993
# IMAP_USER=real-email@domain.com
# IMAP_PASS=real-password

# Live testing (Requires credentials)
# IMAP_ADAPTER=godaddy cargo test --test e2e_live

# IMAP Operation Timeouts
# Timeout for APPEND operations (saving emails to folders) in seconds
# Default: 35 seconds (handles slow servers with security scanning)
IMAP_APPEND_TIMEOUT_SECONDS=35

# RustyMail REST API Server Configuration
# Bind to loopback: the API reaches your mailboxes. Use 0.0.0.0 only behind
# a firewall and a TLS reverse proxy.
REST_HOST=127.0.0.1
REST_PORT=9437  # Uncommon port for REST API

# Legacy REST API at /api/v1 (per-key mailbox credentials). Nothing in
# RustyMail uses it, so it is off by default.
REST_API_V1_ENABLED=false

# RustyMail SSE Server Configuration
SSE_HOST=127.0.0.1
SSE_PORT=9438   # Uncommon port for SSE endpoint

# Dashboard Configuration (if enabled)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=9439  # Vite dev server only (npm run dev); the backend serves the built UI on REST_PORT
DASHBOARD_PATH=frontend/rustymail-app-main/dist  # npm run build output, served at http://REST_HOST:REST_PORT/
DASHBOARD_HOST=127.0.0.1

# Logging Configuration
LOG_LEVEL=info

# Security Configuration
# Set to true to require HTTPS
REQUIRE_HTTPS=false

# Credential Encryption Configuration
# Master key for encrypting stored credentials (IMAP/SMTP passwords)
# Must be exactly 64 hex characters (32 bytes)
# Generate a secure key with: openssl rand -hex 32
# SECURITY: Never commit real encryption keys to version control
# If not set, credentials are stored in plaintext (backward compatible)
# ENCRYPTION_MASTER_KEY=your-64-character-hex-key-here

# CORS Configuration
# Comma-separated list of allowed origins for CORS (required for security)
# Example: http://localhost:9439,http://127.0.0.1:9439,https://dashboard.example.com
# Default: http://localhost:9439,http://127.0.0.1:9439 (for development)
ALLOWED_ORIGINS=http://localhost:9439,http://127.0.0.1:9439

# API Authentication
# API key for MCP clients and the dashboard login (REQUIRED)
# Generate a secure key with: openssl rand -hex 32
# SECURITY: Never commit real API keys to version control
# The browser never receives this key from the server: you enter it once on
# the dashboard's sign-in screen and get an HttpOnly session cookie instead.
# On macOS, leave it out of .env and store it in the Keychain instead; the
# server reads the item apikey:RUSTYMAIL_API_KEY when this is unset:
#   read -rs "?Paste key: " K; echo
#   security add-generic-password -U -a "$USER" -s apikey:RUSTYMAIL_API_KEY -l apikey:RUSTYMAIL_API_KEY -T /usr/bin/security -w "$K"; unset K
# (Not the bare "-w" prompt: it silently truncates input at 128 characters.)
# Generate a key with: openssl rand -hex 32. Full steps: README, "API Key".
# (RUSTYMAIL_API_KEY_KEYCHAIN_SERVICE overrides the item name.)
RUSTYMAIL_API_KEY=your-secure-api-key-here
# How long a dashboard sign-in lasts, in hours (sessions also end on restart)
DASHBOARD_SESSION_TTL_HOURS=12

# Frontend API Configuration
VITE_API_URL=/api

# Rate Limiting Configuration
# Limits are per-IP to prevent abuse
RATE_LIMIT_PER_IP_MINUTE=60       # Max requests per IP per minute (default: 60)
RATE_LIMIT_PER_IP_HOUR=1000       # Max requests per IP per hour (default: 1000)
# Whitelist specific IPs to bypass rate limiting (comma-separated)
# RATE_LIMIT_WHITELIST_IPS=127.0.0.1,192.168.1.100

# Connection Pool Configuration
MAX_CONNECTIONS=10
CONNECTION_TIMEOUT=30  # in seconds
POOL_MIN_CONNECTIONS=1                # Warm connections kept open (NOOP keepalive, never recycled for idleness)
POOL_IDLE_TIMEOUT_SECONDS=60          # Time before closing *surplus* idle connections above the minimum
POOL_HEALTH_CHECK_INTERVAL_SECONDS=30 # Interval for connection health checks
POOL_ACQUIRE_TIMEOUT_SECONDS=5        # Timeout when acquiring a connection
POOL_MAX_SESSION_DURATION_SECONDS=300 # Force connection recycling after this time
POOL_MAX_CONCURRENT_CREATIONS=10      # Max concurrent connection creations

# SSE (Server-Sent Events) Configuration
SSE_HEARTBEAT_INTERVAL_SECONDS=5      # Interval between heartbeat messages
SSE_CLIENT_TIMEOUT_SECONDS=10         # Client timeout for SSE connections

# Cache Configuration
CACHE_MAX_MEMORY_ITEMS=200            # Maximum cached items in memory
CACHE_MAX_FOLDER_ITEMS=50             # Maximum cached folders
CACHE_MAX_SIZE_MB=500                 # Maximum cache size in MB
CACHE_MAX_EMAIL_AGE_DAYS=30           # Maximum age for cached emails
CACHE_SYNC_INTERVAL_SECONDS=300       # Interval for cache sync operations
FAILURE_BACKOFF_BASE_SECONDS=300      # First retry delay after a mail host fails (doubles each failure)
FAILURE_BACKOFF_MAX_SECONDS=3600      # Longest retry delay for sync and pool maintenance

# AI Request Timeout Configuration
AI_REQUEST_TIMEOUT_SECONDS=30         # Default timeout for AI API requests
AI_GENERATION_TIMEOUT_SECONDS=120     # Timeout for longer AI generation requests

# Health Check Thresholds
HEALTH_RESPONSE_TIME_WARNING_MS=1000  # Response time to trigger warning
HEALTH_RESPONSE_TIME_CRITICAL_MS=5000 # Response time to trigger critical alert

# ============================================================================
# Memory Management Configuration
# ============================================================================
# RustyMail uses jemalloc for memory management to properly release memory
# back to the OS after IMAP sessions are closed.
#
# Configure jemalloc to aggressively release memory (optional, defaults are good):
# - dirty_decay_ms: Time before releasing "dirty" (recently freed) pages (default: 10000ms)
# - muzzy_decay_ms: Time before releasing "muzzy" (zero-filled) pages (default: 10000ms)
# - background_thread: Enable background thread for memory maintenance
#
# For aggressive memory release (recommended for memory-constrained environments):
# MALLOC_CONF=background_thread:true,dirty_decay_ms:1000,muzzy_decay_ms:1000
#
# For very aggressive release (may impact performance):
# MALLOC_CONF=background_thread:true,dirty_decay_ms:0,muzzy_decay_ms:0

# ============================================================================
# Database Configuration
# ============================================================================
# RustyMail uses a single SQLite database for email caching and account storage
# Location: ./data/email_cache.db (automatically created on first run)
CACHE_DATABASE_URL=sqlite:data/email_cache.db
#
# This database stores:
# - Cached email messages (for faster loading)
# - Email folders and sync state
# - Account information (synced from config/accounts.json)
#
# Note: Account configuration is stored in config/accounts.json (file-based)
# and synchronized to the database for query performance

# ============================================================================
# Forensic Archive Configuration
# ============================================================================
# Directory for forensic email archives (created during UIDVALIDITY changes)
# These archives preserve cached emails before cache flush for forensic review.
FORENSIC_ARCHIVE_DIR=data/forensic_archives

# ============================================================================
# Evidence Export Configuration
# ============================================================================
# Directory for evidence exports (organized email/attachment packages for review)
EVIDENCE_EXPORT_DIR=data/evidence_exports
# Maximum number of emails per evidence export (default: 10000)
EVIDENCE_EXPORT_MAX_EMAILS=10000

# ============================================================================
# AI Service Configuration (for chatbot functionality)
# ============================================================================
# Uncomment and set the appropriate API key and base URL for your chosen provider
# Most providers use OpenAI-compatible APIs with /v1/chat/completions endpoint

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenRouter (Multi-provider gateway) ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- DeepSeek ---
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- xAI (Grok) ---
# XAI_API_KEY=...
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-beta

# --- Google Gemini ---
# GEMINI_API_KEY=...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
# GEMINI_MODEL=gemini-2.5-flash

# --- Mistral AI ---
# MISTRAL_API_KEY=...
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=mistral-large-latest

# --- Together AI ---
# TOGETHER_API_KEY=...
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# --- Morpheus (Decentralized AI) ---
# MORPHEUS_API_KEY=...
# MORPHEUS_BASE_URL=https://api.mor.org/api/v1
# MORPHEUS_MODEL=LMR-Hermes-3-Llama-3.1-8B

# --- Azure OpenAI ---
# Azure uses a different URL format: https://{resource-name}.openai.azure.com/openai/deployments/{deployment-id}
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-01

# --- Ollama (Self-hosted) ---
# Note: Uses native Ollama API (NOT /v1 endpoint) for full sampler control
# Default settings: temp=0.7, top_p=1.0, repeat_penalty=1.0, num_ctx=51200, think=false
# OLLAMA_MODEL is the one model for the chat panel, the tool-calling agent and
# drafting, unless a role is set otherwise in the dashboard. It is kept at
# startup even if the server's model list omits it.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=hf.co/unsloth/GLM-4.7-Flash-GGUF:Q8_K_XL
# How long Ollama keeps the model loaded after a request, as an Ollama
# duration ("30m"; a bare number is ignored). Unset: the server's setting.
# OLLAMA_KEEP_ALIVE=30m

# --- llama.cpp Server (Self-hosted) ---
# Advanced sampling with min-p, top-no support
# Default settings: temp=0.7, top_p=1.0, min_p=0.01, repeat_penalty=1.0
# LLAMACPP_BASE_URL=http://localhost:8080
# LLAMACPP_MAX_TOKENS=4096
# LLAMACPP_TEMPERATURE=0.7

# --- LM Studio (Self-hosted with OpenAI-compatible API) ---
# LM Studio provides an OpenAI-compatible API for local models
# Default port is 1234, supports min-p and other advanced samplers
# LMSTUDIO_BASE_URL=http://localhost:1234
# LMSTUDIO_MAX_TOKENS=4096
# LMSTUDIO_TEMPERATURE=0.7

# --- model_serve (Self-hosted model server, OpenAI-compatible API) ---
# When both are set, model_serve is the default for the chat panel, the
# tool-calling agent and drafting (ahead of Ollama). Its routes own every
# inference setting (context, keep-alive, thinking, sampling): RustyMail sends
# only the model and the messages, so the dashboard offers no sampler
# settings for it and one loaded copy of the model serves every caller.
# MODEL_SERVE_BASE_URL=http://127.0.0.1:5846
# MODEL_SERVE_MODEL=ms/gemma4-26b-a4b-it-q4_k_m

# ============================================================================
# AI Model Configuration (for High-Level MCP variant) - REQUIRED
# ============================================================================
# AI features require model configuration. Configure via the WebUI Settings
# page or MCP tools BEFORE using AI features. No defaults are provided.
#
# Recommended models for Ollama:
#   Tool-calling (fast, capable): hf.co/unsloth/GLM-4.7-Flash-GGUF:Q8_K_XL
#   Drafting (quality content):   gemma3:27b-it-q8_0
#
# Pull these models in Ollama:
#   ollama pull hf.co/unsloth/GLM-4.7-Flash-GGUF:Q8_K_XL
#   ollama pull gemma3:27b-it-q8_0

# ============================================================================
# Microsoft 365 OAuth2 Configuration
# ============================================================================
# Register an app in the Microsoft Entra (Azure AD) portal to get these values.
# Required scopes: IMAP.AccessAsUser.All, SMTP.Send, offline_access
# Redirect URI: {OAUTH_REDIRECT_BASE_URL}/api/dashboard/oauth/callback/microsoft
#
# MICROSOFT_CLIENT_ID=your-azure-app-client-id
# MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
# MICROSOFT_TENANT_ID=your-azure-ad-tenant-id
# OAUTH_REDIRECT_BASE_URL=http://localhost:9439

# OAuth Token Auto-Refresh: how often to check for expiring tokens (seconds, default: 300)
# TOKEN_REFRESH_CHECK_INTERVAL_SECONDS=300

# ============================================================================
# MCP Stdio Proxy Configuration (for Claude Desktop integration)
# ============================================================================
# The thin stdio proxy (rustymail-mcp-stdio) relays JSON-RPC from Claude Desktop
# to the backend MCP server via HTTP
MCP_BACKEND_URL=http://localhost:9437/mcp
MCP_TIMEOUT=30

# ============================================================================
# Agent Executor Configuration
# ============================================================================
# Maximum iterations for the AI agent when processing email instructions
# Set high to handle bulk operations (e.g., processing 10,000 emails)
# Default: 1000
AGENT_MAX_ITERATIONS=1000

# Most tool rounds the dashboard chat assistant takes in one reply. When they
# run out, it is asked once more, without tools, to say what it did, so the
# reply is never empty. Default: 5
CHATBOT_MAX_TOOL_ROUNDS=5

# ============================================================================
# AI Sampler Configuration (for local LLM providers)
# ============================================================================
# Default sampler settings for Ollama, llama.cpp, and LM Studio
# These defaults are used when no per-model config exists in the database
# Users can override these per-model via the WebUI Settings page
#
# Configuration priority (highest to lowest):
#   1. Database record for specific (provider, model_name) - set via Web UI
#   2. These environment variables - deployment-time defaults
#   3. Code defaults in Rust adapters - last resort fallback

# Core sampler parameters
SAMPLER_DEFAULT_TEMPERATURE=0.7       # 0.0 = deterministic, higher = more random
SAMPLER_DEFAULT_TOP_P=1.0             # Nucleus sampling (1.0 = disabled)
SAMPLER_DEFAULT_TOP_K=                # Top-k sampling (empty = disabled)
SAMPLER_DEFAULT_MIN_P=0.01            # Min-p sampling (llama.cpp default: 0.05)
SAMPLER_DEFAULT_TYPICAL_P=            # Tail-free sampling (empty = disabled, try 0.95)
SAMPLER_DEFAULT_REPEAT_PENALTY=1.0    # Repeat penalty (1.0 = disabled)

# Context and generation limits
SAMPLER_DEFAULT_NUM_CTX=51200         # Context window size in tokens
SAMPLER_DEFAULT_MAX_TOKENS=           # Max tokens to generate (empty = no limit)

# Thinking mode for reasoning models (GLM-4, Qwen, etc.)
SAMPLER_DEFAULT_THINK_MODE=false      # true/false - disable verbose reasoning

# System prompt override (empty = use default RustyMail assistant prompt)
# SAMPLER_DEFAULT_SYSTEM_PROMPT=You are RustyMail Assistant...

# Note: Per-model configurations can be set via:
#   1. WebUI: Settings > AI Configuration > Sampler Settings
#   2. MCP: update_sampler_config tool
# Changes are stored in the database and override these env vars



# =============================================================================
# Email triage (rustymail-triage)
# =============================================================================
# Proposes a bucket for INBOX mail (Spam, Noise, Accounting, Legal, Credit,
# Alerts, Needs Reply; expired one-time codes and password resets go to Trash).
# Accounting, Legal and Credit are inboxes for later processing by agents;
# "Receipts", the old name for Accounting, is still accepted. Proposing never
# changes the mailbox; `rustymail-triage --apply` moves stored proposals and
# verifies every move. Nothing is deleted or expunged.
#
# Accounts triaged when --account is not given (comma-separated email
# addresses of accounts configured in RustyMail). Only listed accounts are
# triaged.
TRIAGE_ACCOUNTS=you@example.com,work@example.org
TRIAGE_FOLDER=INBOX
# Local OpenAI-compatible model server only (loopback is enforced; never a
# cloud model). The large model is asked only when the small one is unsure.
# With the decision model below, the large model is its second pass: answers
# below TRIAGE_MIN_CONFIDENCE go to it, with TRIAGE_SECOND_PASS_EXCERPT_CHARS
# of the body, and its answer is used. If it fails, the decision model's
# answer stands and a warning is logged. Unset TRIAGE_MODEL_LARGE to turn the
# second pass off. Serve it with thinking off and a fixed context so it stays
# loaded between messages.
TRIAGE_MODEL_URL=http://127.0.0.1:5846/v1
TRIAGE_MODEL=ms/qwen3-4.0b-q8_0
TRIAGE_MODEL_LARGE=ms/gemma4-26b-a4b-it-q4_k_m
# Ask the large model when the small one's confidence is below this.
TRIAGE_ESCALATE_BELOW=0.7
TRIAGE_MODEL_TIMEOUT_SECONDS=120
# Decision model (loopback only), Ollama's /v1/systemone API. When both are
# set it replaces the chat model above: it returns probabilities, so the
# confidence used by --apply means something. Needs Ollama 0.35 or later and
# `ollama pull autotrust-jev:9b`. Through model_serve (port 5846) it stays
# loaded for model_serve's MODEL_TTL; on Ollama directly
# (http://127.0.0.1:11434, model autotrust-jev:9b) it unloads after Ollama's
# keep-alive and the next run pays the load again.
TRIAGE_DECISION_URL=http://127.0.0.1:5846
TRIAGE_DECISION_MODEL=ms/autotrust-jev-9b
# Messages fetched per IMAP round trip; the watermark is saved after each batch.
TRIAGE_FETCH_BATCH=20
# Characters of plain text the model sees (headers, sender and subject too;
# never the full body or HTML).
TRIAGE_BODY_EXCERPT_CHARS=500
# Characters of plain text the second-pass model reads.
TRIAGE_SECOND_PASS_EXCERPT_CHARS=2000
# Optional JSON of known senders: {"addresses": {...}, "domains": {...},
# "subjects": [{"domain", "subject" pattern, "bucket"}]}. Subject rules are for
# senders whose mail splits between buckets. See config/triage_senders.example.json.
# TRIAGE_SENDER_RULES_FILE=config/triage_senders.json
# Mailing-list posts (List-Id plus a mailto: List-Post) go to Lists, one
# folder per list; notifications whose List-Id is under one of these code-host
# domains go to Repos, one folder per repository. Comma-separated.
TRIAGE_REPO_LIST_DOMAINS=github.com
# Platforms that deliver mail on someone's behalf (document sharing,
# e-signature, events, payment requests). A model's Accounting, Legal, Credit
# or Alerts proposal waits in the INBOX ("new sender: verify") unless the owner
# has dealt with whoever is behind it: for these platforms, the person in
# Reply-To. Comma-separated.
TRIAGE_PLATFORM_DOMAINS=google.com,docusign.net,docusign.com,zoom.us,paypal.com,booking.com,ccsend.com,dropbox.com,dropboxmail.com
# Also review each account's spam folder (the one the server marks \Junk, or
# the TRIAGE_FOLDER_MAP_FILE entry for Spam): mail the server misfiled is
# proposed for rescue to the folder it belongs in (the INBOX for Keep). A Spam
# verdict, a new sender's trusted-looking document and mail that talks to the
# sorter stay; so does mail triage itself filed as Spam, unless you correct it.
TRIAGE_REVIEW_JUNK=true
# How long a code or reset that states no expiry stays in the INBOX.
TRIAGE_CODE_WINDOW_HOURS=24
# --apply: model proposals below this confidence stay in the INBOX.
TRIAGE_MIN_CONFIDENCE=0.8
# A model's Needs Reply only for mail newer than this many days; older mail
# from people stays in the INBOX.
TRIAGE_NEEDS_REPLY_DAYS=30
# --apply: buckets that are moved. Needs Reply (mail from real people) is left
# out on purpose so it stays in the INBOX; add it here to move it too.
TRIAGE_APPLY_BUCKETS=Spam,Noise,Accounting,Legal,Credit,Alerts,Lists,Repos,Trash
# Optional per-account folder names, e.g.
# {"you@example.com": {"Spam": "INBOX.Junk", "Trash": "Deleted Items"}}.
# Without it, Spam and Trash go to the folders the server marks \Junk and
# \Trash; other buckets follow the account's namespace (INBOX.Noise or Noise).
# A server that marks none falls back to INBOX.Spam / Spam and an existing
# Trash / INBOX.Trash / Deleted Items folder.
# TRIAGE_FOLDER_MAP_FILE=config/triage_folders.json
# Report deep links; defaults to http://REST_HOST:REST_PORT.
# TRIAGE_DASHBOARD_URL=http://127.0.0.1:9437
